<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="true" />
  <arg name="input/pointcloud" default="/sensing/lidar/pointcloud"/>
  <arg name="output/objects" default="/perception/apollo/objects"/>
  <arg name="config_file" default="$(find-pkg-share nebula_ros)/config/lidar/velodyne/VLS128.param.yaml"/>
  

  <!-- 1. Init Set -->
  <!-- 1.1 PointField Conversion -->
  <node pkg="kiapi_perception_launch" exec="pointcloud_xyzirt_bypass_node" name="pointcloud_xyzirt_bypass_node" output="screen" />
  
  <!-- 1.2 Static TF -->
  <!-- <node pkg="tf2_ros" exec="static_transform_publisher" name="map_base" args="-101.013 91.484 47.574 -0.002 -0.013 0.916 0.400 map base_link" /> -->
  <node pkg="kiapi_perception_launch" exec="infra_static_tf_node">
    <param name="yaml_path" value="$(find-pkg-share kiapi_perception_launch)/config/infra_node.param.yaml"/>
  </node>


  <!-- 2. LiDAR DNN Model based detectors -->
  <!-- 2.1 Apollo instance segmentation -->
  <node pkg="autoware_lidar_apollo_instance_segmentation" exec="autoware_lidar_apollo_instance_segmentation_node" name="lidar_apollo_instance_segmentation" output="screen">
    <remap from="input/pointcloud" to="$(var input/pointcloud)"/>
    <remap from="output/labeled_clusters" to="apollo/clusters"/>
    <param name="onnx_file" value="$(env HOME)/autoware_data/lidar_apollo_instance_segmentation/vls-128.onnx"/>
    <param name="z_offset" value="-2.0"/>
    <param name="precision" value="fp32"/>
    <param name="target_frame" value="base_link"/>
    <param from="$(find-pkg-share autoware_lidar_apollo_instance_segmentation)/config/vls-128.param.yaml"/>
    <param name="build_only" value="false"/>
  </node>

  <!-- 2.2 shape estimation -->
  <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="shape_estimation_node" output="screen">
    <remap from="input" to="apollo/clusters"/>
    <remap from="objects" to="shape_estimated_objects"/>
    <param name="model_path" value="$(env HOME)/autoware_data/shape_estimation/pointnet.onnx"/>
    <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
    <param name="use_vehicle_reference_yaw" value="true"/>
    <param name="use_vehicle_reference_shape_size" value="false"/>
  </node>


  <!-- 2.3 detected_object_feature_remover -->
  <node pkg="autoware_detected_object_feature_remover" exec="detected_object_feature_remover_node" name="detected_object_feature_remover_node" output="screen">
    <remap from="~/input" to="shape_estimated_objects"/>
    <remap from="~/output" to="$(var output/objects)"/>
  </node>

  <!-- 3. Lidar rule-based detectors: object_recognition-->
  <!-- 3.1 ground_segmentation -->
  <node pkg="autoware_ground_segmentation" exec="scan_ground_filter_node" name="scan_ground_filter_node" output="screen">
    <remap from="input" to="$(var input/pointcloud)"/>
    <remap from="output" to="/perception/obstacle_segmentation/pointcloud"/>
    <param from="$(find-pkg-share autoware_ground_segmentation)/config/scan_ground_filter.param.yaml"/>
    <param from="$(find-pkg-share autoware_vehicle_info_utils)/config/vehicle_info.param.yaml"/>
  </node>



  <!-- 3.2 voxel_grid_based_euclidean_cluster -->
  <include file="$(find-pkg-share autoware_euclidean_cluster)/launch/voxel_grid_based_euclidean_cluster.launch.py">
    <arg name="input_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
    <arg name="input_map" value="/map/pointcloud_map"/>
    <arg name="output_clusters" value="/perception/obstacle_clusters"/>
    <arg name="use_low_height_cropbox" value="false"/>
    <arg name="voxel_grid_based_euclidean_param_path" value="$(find-pkg-share autoware_euclidean_cluster)/config/voxel_grid_based_euclidean_cluster.param.yaml"/>
  </include>

  <!-- 3.3 shape estimation -->
  <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="segmentation_shape_estimation_node" output="screen">
    <remap from="input" to="/perception/obstacle_clusters"/>
    <remap from="objects" to="/perception/obstacle_clusters/shape_estimated_objects"/>
    <param name="model_path" value="$(env HOME)/autoware_data/shape_estimation/pointnet.onnx"/>
    <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
    <param name="use_vehicle_reference_yaw" value="true"/>
    <param name="use_vehicle_reference_shape_size" value="false"/>
  </node>
  <!-- 3.4 autoware_detected_object_feature_remover -->
  <node pkg="autoware_detected_object_feature_remover" exec="detected_object_feature_remover_node" name="segmentation_detected_object_feature_remover_node" output="screen">
    <remap from="~/input" to="/perception/obstacle_clusters/shape_estimated_objects"/>
    <remap from="~/output" to="/perception/obstacle_segmentation/objects/feature_removed"/>
  </node>

  <!-- 3.5  detection_by_tracker -->
  <node pkg="autoware_detection_by_tracker" exec="detection_by_tracker_node" name="detection_by_tracker_node" output="screen">
    <remap from="~/input/tracked_objects" to="/perception/object_recognition/tracking/objects"/>
    <remap from="~/input/initial_objects" to="/perception/obstacle_segmentation/objects/feature_removed"/>
    <remap from="~/output" to="/perception/obstacle_segmentation/objects"/>
    <param from="$(find-pkg-share autoware_detection_by_tracker)/config/detection_by_tracker.param.yaml"/>
  </node>

  

  <!-- 4. multi_object_tracker  -->
  <include file="$(find-pkg-share autoware_multi_object_tracker)/launch/multi_object_tracker.launch.xml">
    <arg name="input/detection01/objects" value="/perception/apollo/objects"/>
    <arg name="input/detection01/channel" value="lidar_apollo"/>
    <arg name="input/detection02/objects" value="/perception/obstacle_segmentation/objects"/>
    <arg name="input/detection02/channel" value="lidar_clustering"/>
    <arg name="output/objects" value="/perception/object_recognition/tracking/objects"/>
    <arg name="data_association_matrix_path" value="$(find-pkg-share autoware_multi_object_tracker)/config/data_association_matrix.param.yaml"/>
    <arg name="input_channels_path"  value="$(find-pkg-share autoware_multi_object_tracker)/config/multi_object_tracker_node.param.yaml"/>
    <arg name="tracker_setting_path" value="$(find-pkg-share autoware_multi_object_tracker)/config/multi_object_tracker_node.param.yaml"/>
  </include>

  <!-- 5. occupancy_grid_map -->
  <include file="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/launch/pointcloud_based_occupancy_grid_map.launch.py">
    <arg name="input/obstacle_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
    <arg name="input/raw_pointcloud" value="/sensing/lidar/pointcloud"/>
    <arg name="output" value="/perception/occupancy_grid_map/map"/>
    <arg name="use_intra_process" value="true"/>
    <arg name="use_multithread" value="true"/>
    <arg name="use_pointcloud_container" value="false"/>
    <arg name="param_file" value="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/config/pointcloud_based_occupancy_grid_map.param.yaml"/>
    <arg name="updater_type" value="binary_bayes_filter"/>
    <arg name="updater_param_file" value="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/config/binary_bayes_filter_updater.param.yaml"/>
  </include>
  
</launch>
